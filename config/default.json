{
  "llm": {
    "backend": "stub",
    "max_tokens": 4096,
    "thinking_effort": "off",
    "thinking_format": "glm",
    "anthropic_proxy": {
      "base_url": "${ANTHROPIC_BASE_URL}",
      "api_key": "${ANTHROPIC_AUTH_TOKEN}",
      "model": "claude-opus-4-6",
      "max_tokens": 4096,
      "thinking_effort": "off",
      "thinking_format": "anthropic"
    },
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "api_key": "ollama",
      "model": "qwen3:8b",
      "max_tokens": 4096,
      "thinking_effort": "off",
      "thinking_format": "glm"
    },
    "openai_compat": {
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "${GLM_API_KEY}",
      "model": "glm-4.6",
      "max_tokens": 4096,
      "thinking_effort": "off",
      "thinking_format": "glm"
    },
    "glm_anthropic": {
      "base_url": "https://open.bigmodel.cn/api/anthropic",
      "api_key": "${GLM_API_KEY}",
      "model": "glm-4.6",
      "max_tokens": 4096,
      "thinking_effort": "off",
      "thinking_format": "anthropic"
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "api_key": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-v4-flash",
      "max_tokens": 4096,
      "thinking_effort": "off",
      "thinking_format": "openai"
    },
    "deepseek_anthropic": {
      "base_url": "https://api.deepseek.com/anthropic",
      "api_key": "${DEEPSEEK_API_KEY}",
      "model": "deepseek-v4-flash",
      "max_tokens": 4096,
      "thinking_effort": "off",
      "thinking_format": "anthropic"
    },
    "minicpm_o": {
      "model": "MiniCPM-o-4.5-Q4_K_M",
      "max_tokens": 1024,
      "thinking_effort": "off",
      "thinking_format": "native"
    },
    "stub": {}
  },
  "embedder": {
    "backend": "hashing",
    "dim": 256,
    "openai_compat": {
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "${GLM_API_KEY}",
      "model": "embedding-3"
    }
  },
  "asr": {
    "backend": "stub",
    "language": "zh",
    "faster_whisper": {
      "model_size": "small",
      "device": "cuda",
      "compute_type": "float16",
      "vad_filter": true,
      "beam_size": 1,
      "best_of": 1,
      "condition_on_previous_text": true
    },
    "stub": {}
  },
  "speaker": {
    "backend": "text",
    "pyannote": {
      "hf_token_env": "HF_TOKEN",
      "model": "pyannote/speaker-diarization-3.1"
    }
  },
  "web": {
    "backend": "bing",
    "api": {
      "format": "tavily",
      "api_key": "${TAVILY_API_KEY}",
      "base_url": "",
      "query_param": "q",
      "num_param": "num",
      "key_param": "api_key",
      "result_path": "results",
      "title_field": "title",
      "url_field": "url",
      "snippet_field": "content"
    }
  },
  "local_omni": {
    "enabled": false,
    "model_root": "data/models/MiniCPM-o-4_5-gguf",
    "worker_path": "data/runtime-package/resources/backend/runtime/jarvis-native-worker-cuda.exe",
    "pipe_name": "\\\\.\\pipe\\PersonalAssistant.Omni.v1",
    "verify_hashes": true,
    "request_timeout_seconds": 600,
    "perception_enabled": false,
    "perception_interval_seconds": 1
  },
  "distill": {
    "reflection_interval_hours": 24,
    "min_segments_for_distill": 5,
    "profile_path": "data/persona/profile.json"
  },
  "memory": {
    "dedup_enabled": true,
    "l1_batch_max": 10,
    "priority_drop_thresholds": {
      "fact": 50,
      "event": 60,
      "emotion": 40,
      "preference": 50,
      "intention": 50,
      "skill": 50
    },
    "scene_max": 15,
    "scene_min_memories": 10,
    "distill_every_n": 50,
    "recall": {
      "strategy": "hybrid",
      "max_results": 5,
      "score_threshold": 0.008,
      "timeout_ms": 5000,
      "max_chars_per_memory": 0,
      "max_total_chars": 2000
    }
  },
  "proactive": {
    "check_interval_minutes": 30
  },
  "auth": {
    "token_grace_days": 7
  },
  "storage": {
    "sqlite_path": "data/db/personal_assistant.db",
    "duckdb_path": "data/db/analytics.duckdb"
  },
  "chat": {
    "max_conversations": 128,
    "conversation_ttl_seconds": 3600,
    "max_rounds": 8,
    "max_history_chars": 12000,
    "web_search": "auto"
  },
  "xiaozhi": {
    "llm_max_tokens": 160
  }
}